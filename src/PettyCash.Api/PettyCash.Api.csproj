<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>pettycash-api-local</UserSecretsId>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</RepoRoot>
  </PropertyGroup>

  <!-- Starts .postgres on port 5433 before Debug builds (`dotnet run` does not invoke the MSBuild Run target). -->
  <Target Name="EnsureDevPostgres" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRoot)\scripts\init-dev-postgres.ps1&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PettyCash.Application\PettyCash.Application.csproj" />
    <ProjectReference Include="..\PettyCash.Infrastructure\PettyCash.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\PettyCash.Infrastructure\Seed\staff-directory.json" Link="Seed\staff-directory.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
