# Production API. Set these in Render, not in appsettings.json.
# Connection string must include: SSL Mode=Require
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=
Jwt__Key=
Jwt__Issuer=PettyCash
Jwt__Audience=PettyCash
Proxy__Secret=
Cors__Origins__0=https://your-app.vercel.app
Email__PublicAppBaseUrl=https://your-app.vercel.app
Secrets__Directory=/var/data/secrets
# First password for new staff accounts. Not written to disk. Everyone must change it at sign-in.
Seed__InitialPassword=
Graph__TenantId=
Graph__ClientId=
Graph__ClientSecret=
