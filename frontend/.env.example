# Server-only. The browser never receives these.
# Local defaults match nuxt.config.ts when these are unset.
NUXT_API_BASE=http://localhost:5280
NUXT_PROXY_SECRET=
# FoodBev Entra SPA (sign-in only, not the Graph mail app)
NUXT_MICROSOFT_TENANT_ID=
NUXT_MICROSOFT_CLIENT_ID=
# Optional: Finance_App client secret — server-only on Vercel (confidential token exchange).
NUXT_MICROSOFT_CLIENT_SECRET=
